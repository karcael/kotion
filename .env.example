# Veritabanı bağlantısı (Docker kullanıyorsanız değiştirmenize gerek yok)
DATABASE_URL="postgresql://kotion:kotion@localhost:5432/kotion"

# JWT şifreleme anahtarı (ZORUNLU). Üretimde mutlaka uzun ve rastgele bir
# değerle değiştirin. Örnek üretmek için: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-secret"

# Docker Postgres şifresi (opsiyonel, varsayılan: kotion)
# POSTGRES_PASSWORD=kotion

# Yüklenen dosyaların saklanacağı dizin (opsiyonel, varsayılan: ./data/uploads)
# UPLOAD_DIR=/app/data/uploads

# Docker dış port (3000 doluysa değiştirin)
APP_PORT=3000
